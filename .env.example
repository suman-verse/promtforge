# PromptForge — Environment Variables
# Copy this file to .env.local for local development
# Set these as Vercel Environment Variables in your project settings

# OpenRouter API key — required for AI prompt generation
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter API base URL (do not change unless using a proxy)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default AI model to use for prompt generation
# See available models: https://openrouter.ai/models
DEFAULT_AI_MODEL=openai/gpt-4o-mini

# Your production site URL (used for SEO headers sent to OpenRouter)
SITE_URL=https://promptforge.vercel.app

# Site name shown in OpenRouter dashboard
SITE_NAME=PromptForge
